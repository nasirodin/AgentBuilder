# Non-secret settings. Copy to .env and adjust. Environment variables override these.
# Pydantic AI model string; "test" runs offline with canned replies.
AGENTBUILDER_MODEL=anthropic:claude-opus-5-5
# AGENTBUILDER_MODEL=google:gemini-3.8-flash         # Gemini API (GOOGLE_API_KEY)
# AGENTBUILDER_MODEL=google-vertex:gemini-3.8-flash  # Vertex AI (alias of google-cloud:)

# Vertex AI
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=global   # default; "us"/"eu" serve flash models only, us-central1 lacks newer ones
